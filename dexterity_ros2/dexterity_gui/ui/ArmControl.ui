             <size>
              <width>320</width>
              <height>240</height>
             </size>
            </property>
            <property name="toolTip">
             <string>Camera image (tracker image while tracking). After Start Bootstrapping, click the 6 detection points here.</string>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="trackerButtonsLayout">
            <item>
             <widget class="QPushButton" name="startBootstrapButton">
              <property name="toolTip">
               <string>Freeze the image and click the 6 detection points (see Show Reference)</string>
              </property>
              <property name="text">
               <string>Start Bootstrapping</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="stopBootstrapButton">
              <property name="text">
               <string>Stop Bootstrapping</string>
              </property>
              <property name="toolTip">
               <string>Clear the selected points and unfreeze the image.</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="startTrackerButton">
              <property name="toolTip">
               <string>Send the 6 points to the ICG / M3T tracker</string>
              </property>
              <property name="text">
               <string>Start Tracker</string>
              </property>
             </widget>
            </item>
            <item>
             <widget class="QPushButton" name="showReferenceButton">
              <property name="text">
               <string>Show Reference</string>
              </property>
              <property name="toolTip">
               <string>Show where to click the 6 detection points for the selected object model.</string>
              </property>
             </widget>
            </item>
           </layout>
          </item>
