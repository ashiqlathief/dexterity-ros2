<?xml version="1.0"?>
<sdf version="1.9">
  <model name="apriltag_target">
    <static>true</static>
    <!-- One link: with two links in this static model Gazebo placed the cube inside the pedestal -->
    <link name="target">

      <!-- Pedestal: the top is at 0.7415 m, so the cube centre is at 0.79 m, the height of the wrist camera in the "Home"
           pose. The tag is then in the middle of the image, above the gripper fingers that hide the lower part. -->
      <collision name="pedestal_collision">
        <pose>0 0 0.37075 0 0 0</pose>
        <geometry><box><size>0.2 0.2 0.7415</size></box></geometry>
      </collision>
      <visual name="pedestal">
        <pose>0 0 0.37075 0 0 0</pose>
        <geometry><box><size>0.2 0.2 0.7415</size></box></geometry>
        <material>
          <ambient>0.3 0.3 0.35 1</ambient>
          <diffuse>0.3 0.3 0.35 1</diffuse>
        </material>
      </visual>

      <!-- Cube matching dexterity/config/cad_models/cube_at_rl2.cao -->
      <collision name="cube_collision">
        <pose>0 0 0.79 0 0 0</pose>
        <geometry><box><size>0.097 0.1 0.097</size></box></geometry>
      </collision>
      <visual name="cube">
        <pose>0 0 0.79 0 0 0</pose>
        <geometry><box><size>0.097 0.1 0.097</size></box></geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
        </material>
      </visual>

      <!-- Tag on the -X face of the cube: a thin box whose +Z face is turned towards -X.
           0.09 m texture = 10 tag cells, so the black square (8 cells) is 0.072 m. -->
      <visual name="tag">
        <pose>-0.04875 0 0.79 0 -1.5707963 0</pose>
        <geometry><box><size>0.09 0.09 0.0005</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://apriltag_target/materials/textures/tag36_11_00000.png</albedo_map>
              <metalness>0</metalness>
              <roughness>1</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
