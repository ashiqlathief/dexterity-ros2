		<link name="base_link">
			<pose>0 0 0  0 0 0</pose>

			<collision name="collision">
				<pose>0 0 0.05 0 0 0</pose>
				<geometry>
					<box>
						<size>0.1 0.1 0.1</size>
					</box>
				</geometry>
			</collision>

			<visual name="visual">
