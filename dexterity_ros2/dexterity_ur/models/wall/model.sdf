<?xml version="1.0"?>
<sdf version="1.9">
  <model name="wall">
    <static>true</static>
    <!-- 3 m wide (Y), 2 m high (Z), 0.1 m thick (X). The model origin is on the floor at the centre of the wall. -->
    <link name="wall">
      <pose>0 0 1.0 0 0 0</pose>
      <collision name="collision">
        <geometry><box><size>0.1 3.0 2.0</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.1 3.0 2.0</size></box></geometry>
        <material>
          <ambient>0.8 0.8 0.75 1</ambient>
          <diffuse>0.8 0.8 0.75 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
