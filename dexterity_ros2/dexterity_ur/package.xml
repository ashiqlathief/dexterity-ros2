<?xml version="1.0"?>
<package format="3">
  <name>dexterity_ur</name>
  <version>0.1.0</version>
  <description>Runs the dexterity hand-eye controller on a simulated Universal Robots arm (ROS 2 Jazzy, Gazebo Harmonic).</description>
  <maintainer email="ashiq.lathief@gmail.com">ashiq</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>dexterity</exec_depend>
  <exec_depend>ur_simulation_gz</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>robotiq_description</exec_depend>
  <exec_depend>ur_moveit_config</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>parallel_gripper_controller</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>